{
  "title": "Mukesh: Caps Lock as Escape when tapped, Hyper when held",
  "rules": [
    {
      "description": "Caps Lock tapped = Escape, held = Hyper (⌃⌥⌘⇧)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "caps_lock",
            "modifiers": {
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "left_shift",
              "modifiers": [
                "left_control",
                "left_option",
                "left_command"
              ]
            }
          ],
          "to_if_alone": [
            {
              "key_code": "escape"
            }
          ],
          "parameters": {
            "basic.to_if_alone_timeout_milliseconds": 180,
            "basic.to_if_held_down_threshold_milliseconds": 120
          }
        }
      ]
    }
  ]
}
